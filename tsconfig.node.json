{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2023"],
    "outDir": "dist",
    "rootDir": ".",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "declaration": false,
    "sourceMap": true,
    "types": ["node"]
  },
  "include": ["packages/**/*.ts", "apps/cli/**/*.ts", "apps/desktop/electron/**/*.ts", "apps/desktop/electron/**/*.cts"],
  "exclude": ["**/*.test.ts", "apps/desktop/src"]
}
