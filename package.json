{
  "name": "hoplane",
  "version": "0.1.0",
  "description": "Local-first MCP gateway for policy-controlled SSH access",
  "author": "Hoplane",
  "private": true,
  "type": "module",
  "main": "dist/apps/desktop/electron/main.js",
  "packageManager": "pnpm@11.15.0",
  "bin": {
    "aiterm": "dist/apps/cli/src/index.js",
    "hoplane-core": "dist/packages/core/src/server.js",
    "hoplane-mcp": "dist/packages/mcp-adapter/src/index.js"
  },
  "scripts": {
    "build": "pnpm build:desktop && tsc -p tsconfig.node.json",
    "build:desktop": "vite build --config apps/desktop/vite.config.ts",
    "dev": "concurrently -k -n core,ui -c blue,green \"pnpm dev:core\" \"pnpm dev:desktop\"",
    "dev:core": "tsx packages/core/src/server.ts",
    "dev:desktop": "vite --config apps/desktop/vite.config.ts",
    "core": "node dist/packages/core/src/server.js",
    "cli": "node dist/apps/cli/src/index.js",
    "mcp": "node dist/packages/mcp-adapter/src/index.js",
    "app": "electron .",
    "build:app": "pnpm build && electron-builder --mac",
    "build:app:win": "pnpm build && electron-builder --win --x64",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p apps/desktop/tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.17.5",
    "chokidar": "^5.0.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "ssh2": "^1.17.0",
    "yaml": "^2.9.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@types/ssh2": "^1.15.5",
    "@vitejs/plugin-react": "^5.0.2",
    "concurrently": "^9.2.1",
    "electron": "^43.1.1",
    "electron-builder": "^26.15.3",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "vitest": "^3.2.4"
  },
  "build": {
    "appId": "dev.hoplane.app",
    "productName": "Hoplane",
    "asar": true,
    "npmRebuild": false,
    "files": [
      "dist/**",
      "apps/desktop/dist/**",
      "apps/desktop/electron/tray.svg",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "integrations/codex/hoplane",
        "to": "codex/hoplane",
        "filter": [
          "**/*"
        ]
      }
    ],
    "directories": {
      "output": "release"
    },
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        "dmg",
        "zip"
      ],
      "identity": null
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "${productName}-${version}-windows-${arch}.${ext}",
      "requestedExecutionLevel": "asInvoker"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
